<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night_background"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="28dp"
    android:paddingVertical="40dp">

    <TextView
        android:id="@+id/previewBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/lock_preview_badge"
        android:textColor="@color/emergency"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:text="23:00"
        android:textColor="@color/night_text"
        android:textSize="64sp" />

    <TextView
        android:id="@+id/headline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/lock_headline"
        android:textColor="@color/night_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/unlockAt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/night_primary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/night_text_muted"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/explainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:text="@string/lock_explainer"
        android:textColor="@color/night_text_muted"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonPhone"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="24dp"
        android:text="@string/lock_button_phone"
        android:textSize="17sp"
        app:cornerRadius="30dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonEmergency"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="@string/lock_button_emergency"
        android:textColor="@color/emergency"
        app:cornerRadius="28dp"
        app:strokeColor="@color/emergency" />

    <TextView
        android:id="@+id/usesLeft"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textColor="@color/night_text_muted"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/lock_emergency_note"
        android:textColor="@color/night_text_muted"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonClosePreview"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/lock_preview_close"
        android:visibility="gone" />
</LinearLayout>
